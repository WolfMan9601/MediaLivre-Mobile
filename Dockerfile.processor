FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv ffmpeg ca-certificates && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN python3 -m venv /opt/processor && /opt/processor/bin/pip install --no-cache-dir -r processor/requirements.txt && pnpm build
ENV NODE_ENV=production PORT=3000 MEDIALIVRE_PYTHON=/opt/processor/bin/python
RUN useradd --system --uid 10001 --create-home media && chown -R media:media /app
USER media
EXPOSE 3000
CMD ["node", "dist/index.js"]
