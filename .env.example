# Apenas para um clone independente. No projeto gerido, o ambiente é carregado pelo Dashboard.
# Endereço HTTPS estável que o APK pode usar por predefinição; deixar vazio mantém a configuração em Ajustes.
EXPO_PUBLIC_PROCESSOR_URL=
# API de desenvolvimento acessível ao dispositivo, não localhost do telemóvel.
EXPO_PUBLIC_API_BASE_URL=
# Executável Python do processador (variável de servidor, não EXPO_PUBLIC).
MEDIALIVRE_PYTHON=python3
